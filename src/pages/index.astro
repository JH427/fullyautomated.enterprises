---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import LabCard from '../components/LabCard.astro';
import ProductCard from '../components/ProductCard.astro';

const allLabs = await getCollection('labs');
const featuredLabs = allLabs
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
	.slice(0, 3);

const allProducts = await getCollection('products');
---

<Layout
	title="Fully Automated Enterprises"
	description="An experimental studio exploring autonomous, AI-driven business systems."
>
	<Navigation />

	<main>
		<section class="py-24 md:py-32">
			<Container>
				<div class="max-w-3xl">
					<h1 class="text-4xl md:text-5xl font-medium mb-6 leading-tight">
						Fully Automated Enterprises
					</h1>
					<p class="text-xl text-light-text-secondary dark:text-dark-text-secondary leading-relaxed">
						An experimental studio exploring autonomous, AI-driven business systems.
					</p>
				</div>
			</Container>
		</section>

		<section class="py-16 border-t border-light-border dark:border-dark-border">
			<Container>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					<div>
						<h2 class="text-lg font-medium mb-3">Research</h2>
						<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary leading-relaxed">
							We run experiments in real operational contexts, testing the boundaries of AI-driven automation. Every experiment is documented with full transparency.
						</p>
					</div>
					<div>
						<h2 class="text-lg font-medium mb-3">Experiments</h2>
						<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary leading-relaxed">
							Our lab notes document what works, what fails, and unexpected behaviors. We measure failure as rigorously as success.
						</p>
					</div>
					<div>
						<h2 class="text-lg font-medium mb-3">Products</h2>
						<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary leading-relaxed">
							When experiments yield useful tools, we incubate them as self-serve products. No consulting, no custom implementations.
						</p>
					</div>
				</div>
			</Container>
		</section>

		<section class="py-16 border-t border-light-border dark:border-dark-border">
			<Container>
				<div class="flex items-center justify-between mb-8">
					<h2 class="text-2xl font-medium">Featured Experiments</h2>
					<a href="/labs" class="text-sm text-accent-blue hover:underline">
						View all →
					</a>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{featuredLabs.map((lab) => (
						<LabCard
							title={lab.data.title}
							slug={lab.slug}
							status={lab.data.status}
							date={lab.data.date}
							summary={lab.data.summary}
							tags={lab.data.tags}
						/>
					))}
				</div>
			</Container>
		</section>

		<section class="py-16 border-t border-light-border dark:border-dark-border">
			<Container>
				<div class="mb-8">
					<h2 class="text-2xl font-medium mb-2">Product Incubation</h2>
					<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary">
						Tools emerging from our experiments, currently in development
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{allProducts.map((product) => (
						<ProductCard
							title={product.data.title}
							stage={product.data.stage}
							summary={product.data.summary}
							cta={product.data.cta}
						/>
					))}
				</div>
			</Container>
		</section>

		<section class="py-16 border-t border-light-border dark:border-dark-border">
			<Container>
				<div class="max-w-2xl">
					<h2 class="text-2xl font-medium mb-6">Connect</h2>
					<div class="flex flex-wrap gap-6">
						<a
							href="https://x.com"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2 text-sm text-accent-blue hover:underline"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
							</svg>
							X (Twitter)
						</a>
						<a
							href="https://github.com"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2 text-sm text-accent-blue hover:underline"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
							</svg>
							GitHub
						</a>
						<a
							href="https://youtube.com"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2 text-sm text-accent-blue hover:underline"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
							</svg>
							YouTube
						</a>
					</div>
				</div>
			</Container>
		</section>
	</main>

	<Footer />
</Layout>
