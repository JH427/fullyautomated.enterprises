---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';

const allProducts = await getCollection('products');
const sortedProducts = allProducts.sort((a, b) => {
	const stageOrder = { Live: 0, Beta: 1, Incubation: 2, Idea: 3 };
	return stageOrder[a.data.stage] - stageOrder[b.data.stage];
});

const stageColors = {
	Idea: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
	Incubation: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
	Beta: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
	Live: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
};
---

<Layout
	title="Products - Fully Automated Enterprises"
	description="Self-serve tools emerging from our experiments. All products are in various stages of incubation."
>
	<Navigation />

	<main>
		<section class="py-16 md:py-24">
			<Container>
				<div class="max-w-3xl mb-12">
					<h1 class="text-3xl md:text-4xl font-medium mb-4">Products</h1>
					<p class="text-lg text-light-text-secondary dark:text-dark-text-secondary leading-relaxed mb-6">
						Tools emerging from our experiments. These are self-serve products built for our own needs, made available when they reach sufficient maturity.
					</p>
					<div class="p-4 bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border rounded-lg">
						<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary">
							All products are incubating. We do not offer consulting, implementation services, or custom development.
						</p>
					</div>
				</div>

				<div class="space-y-8">
					{sortedProducts.map(async (product) => {
						const { Content } = await product.render();
						return (
							<article class="p-6 md:p-8 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface">
								<div class="flex items-start justify-between mb-4">
									<div>
										<span class={`text-xs px-2 py-1 rounded font-mono ${stageColors[product.data.stage]}`}>
											{product.data.stage}
										</span>
									</div>
								</div>

								<h2 class="text-2xl font-medium mb-3">
									{product.data.title}
								</h2>

								<p class="text-base text-light-text-secondary dark:text-dark-text-secondary leading-relaxed mb-6">
									{product.data.summary}
								</p>

								<div class="prose prose-sm dark:prose-invert max-w-none mb-6">
									<Content />
								</div>

								<button
									disabled
									class="text-sm px-4 py-2 rounded border border-light-border dark:border-dark-border text-light-text-secondary dark:text-dark-text-secondary cursor-not-allowed opacity-60"
								>
									{product.data.cta}
								</button>
							</article>
						);
					})}
				</div>
			</Container>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.prose :global(h2) {
		@apply text-lg font-medium mt-6 mb-3;
	}

	.prose :global(h3) {
		@apply text-base font-medium mt-4 mb-2;
	}

	.prose :global(p) {
		@apply text-sm leading-relaxed mb-3 text-light-text-secondary dark:text-dark-text-secondary;
	}

	.prose :global(ul),
	.prose :global(ol) {
		@apply mb-3 ml-5;
	}

	.prose :global(li) {
		@apply mb-1 text-sm text-light-text-secondary dark:text-dark-text-secondary;
	}
</style>
