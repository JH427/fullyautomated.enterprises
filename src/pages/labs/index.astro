---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
const labs = await getCollection('labs');
const groups = [{kind:'historical', title:'Historical notes', description:'Earlier operating experiments, preserved with their limits. These are not current projects.'}, {kind:'correction',title:'Corrections',description:'Old demo addresses retained with a clear correction, not unsupported results.'}];
---
<Layout title="Lab notes — Fully Automated Enterprises" description="Historical operating notes and explicit corrections to earlier demonstration copy."><Navigation/><main id="main-content" class="studio-wrap"><header class="page-intro"><p class="eyebrow">The studio notebook / Earlier work</p><h1>Notes, not<br/><em>success stories.</em></h1><p class="deck">A record is useful only if its limits stay attached. Earlier workflow notes live here; unsupported demos are marked as corrections.</p><a class="text-link" href="/work">For current software, start with Work ↗</a></header><div class="notebook">{groups.map(group=><section class="lab-group"><h2>{group.title}</h2><p>{group.description}</p><div>{labs.filter(lab=>lab.data.kind === group.kind).sort((a,b)=>b.data.date.localeCompare(a.data.date)).map(lab=><article class="lab-entry"><div><span class="maturity">{group.kind === 'historical' ? 'Historical note · Archived' : 'Unsupported demo · Correction'}</span><h3><a href={`/labs/${lab.slug}`}>{lab.data.title} <span aria-hidden="true">↗</span></a></h3></div><p>{lab.data.summary}</p></article>)}</div></section>)}</div></main><Footer/></Layout>
