---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Container from '../../components/Container.astro';
import LabCard from '../../components/LabCard.astro';

const allLabs = await getCollection('labs');
const sortedLabs = allLabs.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(allLabs.flatMap(lab => lab.data.tags))].sort();
---

<Layout
	title="Labs - Fully Automated Enterprises"
	description="Experiments exploring autonomous, AI-driven business systems. Research notes, findings, and observations."
>
	<Navigation />

	<main>
		<section class="py-16 md:py-24">
			<Container>
				<div class="max-w-3xl mb-12">
					<h1 class="text-3xl md:text-4xl font-medium mb-4">Labs</h1>
					<p class="text-lg text-light-text-secondary dark:text-dark-text-secondary leading-relaxed">
						Documented trials in agent operations and autonomous systems, including setup choices, observed behavior, and failure modes.
					</p>
				</div>

				<div class="mb-12">
					<h2 class="text-sm font-mono text-light-text-secondary dark:text-dark-text-secondary mb-4">Filter by tag</h2>
					<div class="flex flex-wrap gap-2">
						<button
							class="filter-tag text-xs px-3 py-1.5 rounded border border-light-border dark:border-dark-border font-mono hover:border-accent-blue hover:text-accent-blue transition-colors"
							data-tag="all"
						>
							All
						</button>
						{allTags.map((tag) => (
							<button
								class="filter-tag text-xs px-3 py-1.5 rounded border border-light-border dark:border-dark-border font-mono hover:border-accent-blue hover:text-accent-blue transition-colors"
								data-tag={tag}
							>
								{tag}
							</button>
						))}
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{sortedLabs.map((lab) => (
						<LabCard
							title={lab.data.title}
							slug={lab.slug}
							status={lab.data.status}
							date={lab.data.date}
							summary={lab.data.summary}
							tags={lab.data.tags}
						/>
					))}
				</div>
			</Container>
		</section>
	</main>

	<Footer />

	<script>
		document.addEventListener('astro:page-load', () => {
			const filterTags = document.querySelectorAll('.filter-tag');
			const labCards = document.querySelectorAll('a[href^="/labs/"]');

			filterTags.forEach(button => {
				button.addEventListener('click', () => {
					const selectedTag = button.getAttribute('data-tag');

					filterTags.forEach(btn => btn.classList.remove('border-accent-blue', 'text-accent-blue'));
					button.classList.add('border-accent-blue', 'text-accent-blue');

					labCards.forEach(card => {
						if (selectedTag === 'all') {
							card.style.display = 'block';
						} else {
							const cardTags = Array.from(card.querySelectorAll('.font-mono')).slice(1);
							const hasTag = cardTags.some(tagEl => tagEl.textContent?.trim() === selectedTag);
							card.style.display = hasTag ? 'block' : 'none';
						}
					});
				});
			});

			filterTags[0]?.classList.add('border-accent-blue', 'text-accent-blue');
		});
	</script>
</Layout>
