---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
---

<Layout
	title="Contact - Fully Automated Enterprises"
	description="Get in touch with Fully Automated Enterprises. Research inquiries and partnership discussions only."
>
	<Navigation />

	<main>
		<section class="py-16 md:py-24">
			<Container>
				<div class="max-w-2xl mx-auto">
					<h1 class="text-3xl md:text-4xl font-medium mb-6">Contact</h1>

					<div class="mb-12">
						<p class="text-lg text-light-text-secondary dark:text-dark-text-secondary leading-relaxed mb-4">
							For research inquiries, partnership discussions, or questions about our experiments, reach out via email.
						</p>
						<p class="text-base text-light-text-secondary dark:text-dark-text-secondary leading-relaxed">
							We do not offer consulting services, implementation support, or custom development work.
						</p>
					</div>

					<div class="space-y-8">
						<div class="p-6 md:p-8 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface">
							<h2 class="text-lg font-medium mb-4">Email</h2>
							<a
								href="mailto:contact@fullyautomated.enterprises"
								class="text-accent-blue hover:underline text-lg"
							>
								contact@fullyautomated.enterprises
							</a>
						</div>

						<div class="p-6 md:p-8 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface">
							<h2 class="text-lg font-medium mb-4">Public</h2>
							<div class="space-y-3">
								<a
									href="https://github.com/JH427"
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-3 text-accent-blue hover:underline"
								>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
									</svg>
									GitHub
								</a>
							</div>
						</div>

						<div class="p-6 md:p-8 rounded-lg border border-accent-blue/30 bg-light-surface dark:bg-dark-surface">
							<h3 class="text-base font-medium mb-3 font-mono">What We Don't Do</h3>
							<ul class="space-y-2 text-sm text-light-text-secondary dark:text-dark-text-secondary">
								<li>• Consulting engagements</li>
								<li>• Implementation services</li>
								<li>• Custom development</li>
								<li>• Client work of any kind</li>
								<li>• Technical support for integrations</li>
							</ul>
						</div>
					</div>
				</div>
			</Container>
		</section>
	</main>

	<Footer />
</Layout>
