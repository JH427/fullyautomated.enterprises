---
import '../styles/studio.css';
interface Props { title?: string; description?: string; ogTitle?: string; ogDescription?: string; }
const { title = 'Fully Automated Enterprises', description = 'An independent studio for local AI, useful tools, and machine-made media.', ogTitle = title, ogDescription = description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const shareImage = new URL('/share.png', Astro.site);
---
<!doctype html>
<html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta name="theme-color" content="#f3f0e7"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={ogTitle}/><meta property="og:description" content={ogDescription}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Fully Automated Enterprises"/><meta property="og:url" content={canonical}/><meta property="og:image" content={shareImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Fully Automated Enterprises — Local AI, tools, and machine-made media"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={ogTitle}/><meta name="twitter:description" content={ogDescription}/><meta name="twitter:image" content={shareImage}/>
</head><body><a class="skip-link" href="#main-content">Skip to content</a><slot /></body></html>
