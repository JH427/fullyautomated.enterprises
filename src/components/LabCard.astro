---
interface Props {
	title: string;
	slug: string;
	status: 'Active' | 'Archived' | 'Productized';
	date: string;
	summary: string;
	tags: string[];
}

const { title, slug, status, date, summary, tags } = Astro.props;

const statusColors = {
	Active: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
	Archived: 'bg-gray-100 text-gray-800 dark:bg-gray-800/30 dark:text-gray-400',
	Productized: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
};
---

<a
	href={`/labs/${slug}`}
	class="block p-6 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface hover:border-accent-blue dark:hover:border-accent-blue transition-all group"
>
	<div class="flex items-start justify-between mb-3">
		<span class={`text-xs px-2 py-1 rounded font-mono ${statusColors[status]}`}>
			{status}
		</span>
		<span class="text-xs font-mono text-light-text-secondary dark:text-dark-text-secondary">
			{date}
		</span>
	</div>

	<h3 class="text-lg font-medium mb-2 group-hover:text-accent-blue transition-colors">
		{title}
	</h3>

	<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary leading-relaxed mb-4">
		{summary}
	</p>

	<div class="flex flex-wrap gap-2">
		{tags.map((tag) => (
			<span class="text-xs px-2 py-1 rounded bg-white dark:bg-dark-bg border border-light-border dark:border-dark-border font-mono">
				{tag}
			</span>
		))}
	</div>
</a>
