---
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/work','Work'], ['/labs','Lab notes'], ['/methodology','Method'], ['/about','About'], ['/contact','Contact']];
const active = (href: string) => current === href || current.startsWith(href + '/') || (href === '/work' && current === '/products');
---
<header class="site-header studio-wrap"><a class="brand" href="/" aria-label="Fully Automated Enterprises — home" aria-current={current === '/' ? 'page' : undefined}><span class="brand-mark" aria-hidden="true">F<span class="brand-dot">/</span>E</span><span class="brand-name">Fully Automated<br/>Enterprises</span></a>
<nav class="desktop-nav" aria-label="Primary navigation">{links.map(([href,label])=><a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</nav>
<details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{links.map(([href,label])=><a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</nav></details>
</header>
