---
interface Props {
	title: string;
	stage: 'Idea' | 'Incubation' | 'Beta' | 'Live';
	summary: string;
	cta: string;
}

const { title, stage, summary, cta } = Astro.props;

const stageColors = {
	Idea: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
	Incubation: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
	Beta: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
	Live: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
};
---

<div class="p-6 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface">
	<div class="flex items-start justify-between mb-3">
		<span class={`text-xs px-2 py-1 rounded font-mono ${stageColors[stage]}`}>
			{stage}
		</span>
	</div>

	<h3 class="text-lg font-medium mb-2">
		{title}
	</h3>

	<p class="text-sm text-light-text-secondary dark:text-dark-text-secondary leading-relaxed mb-4">
		{summary}
	</p>

	<button
		disabled
		class="text-sm px-4 py-2 rounded border border-light-border dark:border-dark-border text-light-text-secondary dark:text-dark-text-secondary cursor-not-allowed opacity-60"
	>
		{cta}
	</button>
</div>
